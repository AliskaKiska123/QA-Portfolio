                  "const data = pm.response.json();\r\n\r\n// Проверка наличия email\r\npm.test(\"Email присутствует в ответе\", function () {\r\n    pm.expect(data).to.have.property(\"email\");\r\n});\r\n\r\n// Проверка значения email\r\npm.test(\"Email соответствует ожидаемому\", function () {\r\n    pm.expect(data.email).to.eql(\"logan.torres@x.dummyjson.com\");\r\n});\r\n\r\n// Проверка типа ID\r\npm.test(\"ID имеет числовой тип\", function () {\r\n    pm.expect(data.id).to.be.a(\"number\");\r\n});\r\n\r\n// Проверка типа email\r\npm.test(\"Email имеет строковый тип\", function () {\r\n    pm.expect(data.email).to.be.a(\"string\");\r\n});"
                ],
                "type": "text/javascript"
              }
